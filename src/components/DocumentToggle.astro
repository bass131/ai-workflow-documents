---
const t = Astro.locals.t;
---
<button type="button" class="document-toggle" disabled aria-controls="starlight__sidebar" aria-expanded="false" aria-label={t('workshop.openDocuments')} data-open-label={t('workshop.openDocuments')} data-close-label={t('workshop.closeDocuments')} title={t('workshop.documentList')}>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M9 4v16m4-11h4m-4 4h4" /></svg>
  <span>{t('workshop.documentList')}</span>
</button>
<script is:inline>
  (() => {
    let open = false;
    try { open = localStorage.getItem('wf-document-list') === 'open'; } catch {}
    document.documentElement.toggleAttribute('data-docs-open', open);
    const button = document.currentScript.previousElementSibling;
    button.setAttribute('aria-expanded', String(open));
    button.setAttribute('aria-label', open ? button.dataset.closeLabel : button.dataset.openLabel);
  })();
</script>
