---
import { languageHref } from '../data/languages';
const t = Astro.locals.t;
const base = languageHref(Astro.currentLocale ?? 'en', '', import.meta.env.BASE_URL);
const sections = [
  { label: t('workshop.guide'), path: 'workflow/overview/', section: 'workflow/' },
  { label: t('workshop.cases'), path: 'experiments/agentdeck/', section: 'experiments/' },
  { label: t('workshop.design'), path: 'design/decisions/', section: 'design/' },
];
---
<nav class="section-nav" aria-label={t('workshop.mainMenu')}>
  {sections.map(({ label, path, section }) => <a href={base + path} aria-current={Astro.url.pathname.startsWith(base + section) ? 'true' : undefined}>{label}</a>)}
</nav>
