---
import { languageHref } from '../data/languages';
interface Props { current?: boolean }
const { current = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<a class="workshop-brand" href={languageHref(Astro.currentLocale ?? 'en', '', base)} aria-label={'Moodie’s Agentic Workflow — ' + Astro.locals.t('workshop.home')} aria-current={current ? 'page' : undefined}>
  <img src={base + 'favicon.svg'} width="32" height="32" alt="" />
  <span class="workshop-brand-name" translate="no"><span>Moodie’s</span> <span>Agentic Workflow</span></span>
</a>
