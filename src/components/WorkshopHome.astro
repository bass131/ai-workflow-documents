---
import LanguagePreference from './LanguagePreference.astro';
import WorkshopLanguageSelect from './WorkshopLanguageSelect.astro';
import { languages, language, languageHref } from '../data/languages';
import { homeContent } from '../data/home';
import MaterialStyles from './MaterialStyles.astro';
import WorkshopBrand from './WorkshopBrand.astro';
import SectionNav from './SectionNav.astro';
import DocumentToggle from './DocumentToggle.astro';
import DocumentDrawer from './DocumentDrawer.astro';
import HomeSidebar from './HomeSidebar.astro';
import { Image } from 'astro:assets';
import mascot from '../assets/wooden-workshop-mascot.png';
import '../styles/theme.css';
import '../styles/home.css';
const base = import.meta.env.BASE_URL;
const current = language(Astro.currentLocale);
const copy = homeContent[current.code];
const t = Astro.locals.t;
const href = (path: string) => languageHref(current.code, path, base);
const steps = copy.steps;
const scenarioKeys = ['minor', 'decision', 'failure', 'resume'] as const;
---
<!doctype html>
<html lang={current.code}>
  <head>
    <meta charset="utf-8" />
    <MaterialStyles />
    <LanguagePreference />
    {Astro.site && <link rel="canonical" href={new URL(href(''), Astro.site)} />}
    {Astro.site && languages.map(item => <link rel="alternate" hreflang={item.code} href={new URL(languageHref(item.code, '', base), Astro.site)} />)}
    {Astro.site && <link rel="alternate" hreflang="x-default" href={new URL(base, Astro.site)} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{copy.title}</title>
    <meta name="description" content={copy.description} />
    <link rel="icon" type="image/svg+xml" href={base + 'favicon.svg'} />
    <script is:inline>
      const preference = (() => { try { return localStorage.getItem('starlight-theme'); } catch { return null; } })();
      document.documentElement.dataset.theme = preference === 'dark' || preference === 'light' ? preference : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    </script>
  </head>
  <body class="home">
    <a class="skip-link" href="#main">{t('skipLink.label')}</a>
    <header class="home-header">
      <DocumentToggle />
      <WorkshopBrand current />
      <SectionNav />
      <WorkshopLanguageSelect standalone />
      <label class="theme-control"><svg class="home-theme-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.4 1.4m11.2 11.2L19 19M5 19l1.4-1.4M17.6 6.4 19 5" /></svg><span class="sr-only">{t('themeSelect.accessibleLabel')}</span><select id="theme" aria-label={t('themeSelect.accessibleLabel')}><option value="auto">{t('themeSelect.auto')}</option><option value="light">{t('themeSelect.light')}</option><option value="dark">{t('themeSelect.dark')}</option></select></label>
    </header>
    <DocumentDrawer><HomeSidebar /></DocumentDrawer>
    <div class="home-body"><main id="main" data-pagefind-body>
      <section class="intro">
        <div class="intro-copy">
          <div class="eyebrow">DEVELOPMENT NOTES <span class="edition">{copy.edition}</span></div>
          <div class="intro-title"><div class="workshop-mascot" aria-hidden="true"><Image src={mascot} width={320} height={320} format="webp" quality={82} alt="" loading="eager" /></div><h1>{copy.heading[0]}{' '}<br /><em>{copy.heading[1]}</em></h1></div>
          <p class="lead">{copy.lead}</p>
          <div class="intro-actions"><a class="primary-link" href={href('workflow/overview/')}>{copy.readOverview} <span aria-hidden="true">→</span></a><a class="text-link" href="#simulation">{copy.explore} <span aria-hidden="true">↓</span></a></div>
          <p class="intro-note">{copy.note}</p>
        </div>
        <figure class="flow">
          <figcaption><span>{copy.flowTitle}</span><span class="small-label">{copy.flowLabel}</span></figcaption>
          <ol>{steps.map(([number, title, description]) => <li><span class="step-number">{number}</span><div><strong>{title}</strong><p>{description}</p></div></li>)}</ol>
          <div class="flow-return"><span aria-hidden="true">↳</span> {copy.flowReturn}</div>
        </figure>
      </section>
      <section class="simulation" id="simulation" aria-labelledby="simulation-title">
        <div class="section-heading"><div><p class="eyebrow">01 / DECISIONS</p><h2 id="simulation-title">{copy.simulationTitle}</h2></div><span class="badge">{copy.simulationLabel}</span></div>
        <p class="section-intro">{copy.simulationIntro}</p>
        <div class="scenario-layout">
          <div class="scenario-buttons" role="group" aria-label={copy.scenarioGroup}>
            {scenarioKeys.map((key, i) => <button type="button" data-scenario={key} aria-pressed={i === 0}><span>{String(i + 1).padStart(2, '0')}</span>{copy.scenarioLabels[i]}<span aria-hidden="true">→</span></button>)}
          </div>
          <div class="scenario-result" aria-live="polite" aria-atomic="true">
            <p class="scenario-status" id="scenario-status">{copy.scenarios.minor.status}</p>
            <h3 id="scenario-title">{copy.scenarios.minor.title}</h3>
            <p id="scenario-reason">{copy.scenarios.minor.reason}</p>
            <div class="scenario-next"><span>{copy.next}</span><p id="scenario-next">{copy.scenarios.minor.next}</p></div>
          </div>
        </div>
        <noscript><p>{copy.noscript}</p></noscript>
      </section>
      <section class="reading" aria-labelledby="reading-title">
        <div class="section-heading"><div><p class="eyebrow">02 / FIELD NOTES</p><h2 id="reading-title">{copy.readingTitle}</h2></div><a class="text-link" href={href('workflow/overview/')}>{copy.openDocs} <span aria-hidden="true">↗</span></a></div>
        <div class="reading-grid">{copy.cards.map(card => <a class="reading-card" href={href(card.path)}><span class="small-label">{card.tag}</span><h3>{card.title}</h3><p>{card.description}</p><span class="card-arrow" aria-hidden="true">↗</span></a>)}</div>
      </section>
      <aside class="scope-note"><span class="badge">{copy.scopeLabel}</span><p>{copy.scope}</p></aside>
    </main></div>
    <footer class="home-footer"><span>Moodie’s Agentic Workflow <span aria-hidden="true">/</span> {copy.footer}</span><span>Astro + Starlight</span></footer>
    <script id="scenario-data" type="application/json" is:inline set:html={JSON.stringify(copy.scenarios).replaceAll('<', '\\u003c')} />
    <script>
      const scenarios = JSON.parse(document.getElementById('scenario-data')!.textContent!) as Record<string, Record<'status'|'title'|'reason'|'next',string>>;
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-scenario]');
      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const key = button.dataset.scenario!;
          const selected = scenarios[key];
          buttons.forEach((item) => item.setAttribute('aria-pressed', String(item === button)));
          for (const field of ['status', 'title', 'reason', 'next'] as const) {
            const element = document.getElementById('scenario-' + field);
            if (element) element.textContent = selected[field];
          }
        });
      });
      const theme = document.getElementById('theme') as HTMLSelectElement;
      let saved = 'auto';
      try { saved = localStorage.getItem('starlight-theme') || 'auto'; } catch {}
      theme.value = ['auto', 'light', 'dark'].includes(saved) ? saved : 'auto';
      const scheme = matchMedia('(prefers-color-scheme: dark)');
      const applyTheme = () => { document.documentElement.dataset.theme = theme.value === 'auto' ? scheme.matches ? 'dark' : 'light' : theme.value; };
      theme.addEventListener('change', () => { try { localStorage.setItem('starlight-theme', theme.value === 'auto' ? '' : theme.value); } catch {} applyTheme(); });
      scheme.addEventListener('change', () => { if (theme.value === 'auto') applyTheme(); });
    </script>
  </body>
</html>
