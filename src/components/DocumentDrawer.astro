<nav id="starlight__sidebar" class="document-drawer sidebar-pane print:hidden" aria-hidden="true" aria-labelledby="document-list-title" data-pagefind-ignore>
  <div class="drawer-heading"><h2 id="document-list-title">문서 목록</h2><button type="button" class="drawer-close" aria-label="문서 목록 닫기"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6" /></svg></button></div>
  <div class="sidebar-content"><slot /></div>
</nav>
<script>
  const key = 'wf-document-list';
  const root = document.documentElement;
  const panel = document.getElementById('starlight__sidebar')!;
  const opener = document.querySelector<HTMLButtonElement>('.document-toggle')!;
  const close = panel.querySelector<HTMLButtonElement>('.drawer-close')!;
  const read = () => {
    try { return localStorage.getItem(key) === 'open'; } catch { return undefined; }
  };
  let open = root.hasAttribute('data-docs-open');
  const setOpen = (next: boolean, persist = false, focus = false) => {
    const focusInside = panel.contains(document.activeElement);
    open = next;
    root.toggleAttribute('data-docs-open', open);
    panel.inert = !open;
    panel.setAttribute('aria-hidden', String(!open));
    opener.setAttribute('aria-expanded', String(open));
    opener.setAttribute('aria-label', open ? '문서 목록 닫기' : '문서 목록 열기');
    if (persist) { try { localStorage.setItem(key, open ? 'open' : 'closed'); } catch {} }
    if (open && focus) close.focus({ preventScroll: true });
    else if (!open && (focus || focusInside)) opener.focus({ preventScroll: true });
  };
  setOpen(read() ?? open);
  opener.disabled = false;
  opener.addEventListener('click', () => setOpen(!open, true, true));
  close.addEventListener('click', () => setOpen(false, true, true));
  // Restoring a page or syncing another tab should never steal the reader's focus.
  window.addEventListener('pageshow', () => setOpen(read() ?? open));
  window.addEventListener('storage', event => {
    if (event.key === key || event.key === null) setOpen(read() ?? open);
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape' || !open) return;
    // Search and the page TOC own Escape while they are open.
    if (document.querySelector('dialog[open], #starlight__mobile-toc[open]')) return;
    event.preventDefault();
    setOpen(false, true, true);
  });
</script>
